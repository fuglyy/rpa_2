значение переменной')\n    #vH6@~Ceb{}|)vKe]|p$?\n    valid_specializations = ['программирование', 'дизайн', 'аналитика']\n\n    log_process(block_text='Присвоить значение переменной')\n\n    log_process(window_log=True,block_text='Присвоить значение переменной')\n    #Vx!Jh:a5okrMPv-tOof_\n    specialization = student_dict['specialization']\n\n    log_process(block_text='Присвоить значение переменной')\n\n    log_process(window_log=True,block_text='Если/вернуть')\n    #pLOw@ea7v,HbqFg:BKK[\n    if first_index(valid_specializations, specialization) == -1:\n        return 'Неверная специализация'\n\n    log_process(block_text='Если/вернуть')\n\n    return 'Специализация подтверждена'\n\n\nlogger = configure_logger()\npuzzle_logger_path = Path(__file__).absolute()\nlogger.info(f'Старт робота: {puzzle_logger_path}')\n\nif __name__ == \"__main__\":\n    def main_sentry_286_proc():\n        try:\n            # Присваивает переменной значение вставки\n            log_process(window_log=True,block_text='Присвоить значение переменной')\n            #EIc1rRzC0UaTKSBhQ#NS\n            students_data = read_file.read_json_file(None,(files_and_folders.get_executable_path('students.json',binary_path='TRUE',block_text=\"Относительный путь\",window_log=True, current_language=\"ru\")),block_text=\"Прочитать текст из json-файла\",window_log=True, current_language=\"ru\")\n\n            log_process(block_text='Присвоить значение переменной')\n\n            log_process(window_log=True,block_text='Присвоить значение переменной')\n            #7MXBJc/wZJ/ZeNv7WoQx\n            specialization_check_list = []\n\n            log_process(block_text='Присвоить значение переменной')\n\n            log_process(window_log=True,block_text='Цикл для каждого элемента')\n            #z9L}X{}]C^_1BDj{D.Wp\n            for student in students_data:\n                log_process(window_log=True,block_text='Присвоить значение переменной')\n                #JiO7u8-GSb$N]vOdZ}OL\n                status = check_specialization_validity(student)\n\n                log_process(block_text='Присвоить значение переменной')\n\n                log_process(window_log=True,block_text='Присвоить значение переменной')\n                #E`rFgp#iP_|XP%!O%%~/\n                result_dict = {\n                    'student_name': (student['student_name']),\n                    'specialization_status': status\n                }\n\n                log_process(block_text='Присвоить значение переменной')\n\n                log_process(window_log=True,block_text='Добавить элемент в список')\n                #p[wjnY9dxIt6?r=eO!1?\n                specialization_check_list.append(result_dict)\n\n                log_process(block_text='Добавить элемент в список')\n\n\n            log_process(block_text='Цикл для каждого элемента')\n\n            #~0={uZ,5X.x*rdlC,G`7\n            files_and_folders.create_json((files_and_folders.get_executable_path('specialization_check.json',binary_path='TRUE',block_text=\"Относительный путь\",window_log=True, current_language=\"ru\")),'utf-8',specialization_check_list,block_text=\"Создать json-файл\",window_log=True, current_language=\"ru\")\n\n            #sVXqde67fumdn#:tQuo0\n            user_notice_2.user_notice(specialization_check_list,None,block_text=\"Уведомление пользователя\",window_log=True, current_language=\"ru\")\n\n\n            logger.info(f'Завершение работы робота: {puzzle_logger_path}')\n            send_message_websocket(message_type=\"python_end\")\n        except Exception as error_puzzle:\n            logger.error(f'{puzzle_logger_path} ' + f'Ошибка: {error_puzzle}')\n            error_puzzle_format=format_traceback(error_puzzle)\n            send_message_websocket(message_type=\"python_error\", message=error_puzzle_format)\n            raise Exception(error_puzzle)\n    main_sentry_286_proc()","pId":"sentry_286"}
